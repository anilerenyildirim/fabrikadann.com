# Veritabanı
DATABASE_URL=postgres://fabrikadann:yerel-gelistirme@127.0.0.1:5433/fabrikadann
TEST_DATABASE_URL=postgres://fabrikadann:yerel-gelistirme@127.0.0.1:5433/fabrikadann_test

# Sitenin dışarıdan görünen adresi (sonunda / yok)
APP_URL=http://localhost:3000

# En az 32 karakterlik rastgele dize: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# mock | iyzico  (mock yalnızca geliştirmede çalışır)
PAYMENT_PROVIDER=mock

# Yüklenen ürün görsellerinin klasörü
UPLOAD_DIR=./uploads

# E-posta (boşsa e-postalar konsola yazılır)
SMTP_URL=
MAIL_FROM="fabrikadann <info@fabrikadann.com>"

# Ters vekilin istemci IP başlığı. Canlıda her zaman x-real-ip (Caddy yazar; Cloudflare için deploy/Caddyfile'daki bloğu açın)
CLIENT_IP_HEADER=

# iyzico (PAYMENT_PROVIDER=iyzico iken)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# sandbox: https://sandbox-api.iyzipay.com  canli: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Trendyol ortak stok (üçü de boşsa kapalı). Satıcı paneli > Hesap Bilgilerim > Entegrasyon Bilgileri
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# prod | stage (stage için sunucu IP'si Trendyol'a tanıtılmalı)
TRENDYOL_ENV=prod
